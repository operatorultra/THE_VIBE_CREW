# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/the_vibe_crew
DATABASE_SSL=false

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=The Vibe Crew <hello@thevibecrew.dev>

# Internal routing and checkout
ASSESSMENT_INTERNAL_TO=hello@thevibecrew.dev
# Stripe Checkout (preferred dynamic flow)
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_PRIORITY_CALL_PRICE_ID=price_123
# Optional: if no price ID is set, we try the product default_price
STRIPE_PRIORITY_CALL_PRODUCT_ID=prod_123
STRIPE_PRIORITY_CALL_SUCCESS_URL=https://thevibecrew.dev/priority-call
STRIPE_PRIORITY_CALL_CANCEL_URL=https://thevibecrew.dev/apply
# Static checkout link fallback
STRIPE_PRIORITY_CALL_URL=https://buy.stripe.com/your-priority-call-link
# Optional legacy fallback
BOOKING_URL=https://cal.com/your-handle/cleanup-call
