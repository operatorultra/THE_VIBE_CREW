---
const brandName = "The Vibe Crew";
const siteUrl = "https://thevibecrew.dev";
const title = `${brandName} | Restore Shipping Velocity in Unstable Codebases`;
const description =
	"If your team slowed down after moving fast, The Vibe Crew diagnoses hidden codebase risk and restores shipping velocity — without a full rewrite.";
const keywords = [
	"The Vibe Crew",
	"shipping velocity",
	"unstable codebase",
	"technical debt audit",
	"fast MVP slowdown",
	"codebase stabilization",
	"AI-assisted development risk",
	"refactor without rewrite"
].join(", ");

const icpSignals = [
	{
		title: "Post-MVP founders",
		pain: "You shipped fast, then velocity dropped while effort went up. Parts of the code feel unsafe to touch and bugs are hard to reproduce."
	},
	{
		title: "Solo builders with traction",
		pain: "You have real users (5k–100k) but scaling hurts. Infra is duct-taped across Supabase, Firebase, and APIs that nobody fully owns."
	},
	{
		title: "Agencies after AI delivery",
		pain: "You used AI to ship client work faster, and now maintenance is painful. Every change risks breaking something you did not build to last."
	}
];

const vibeDebtChecks = [
	"You are afraid to touch parts of the codebase",
	"Bugs reappear after you thought they were fixed",
	"New features take longer than they used to",
	"No one person fully understands how the system works",
	"Shipping velocity dropped while team effort increased",
	"You are hiring or thinking about hiring just to stabilize"
];

const faqs = [
	{
		question: "Who is this for?",
		answer:
			"Founders post-MVP, solo builders with traction, and agencies where shipping slowed down after a fast build phase — especially when AI-assisted code created hidden complexity."
	},
	{
		question: "What is a Vibe Debt Audit?",
		answer:
			"A fixed-scope 3–5 day engagement: we map risk, flag what will likely break in the next 3 months, and deliver a prioritized cleanup sequence. It lowers friction before a full remediation engagement."
	},
	{
		question: "Do we need a full rewrite?",
		answer:
			"Usually no. Most teams need targeted stabilization, clearer ownership, and a scoped roadmap — not throwing away working product surface area."
	},
	{
		question: "What happens after the audit?",
		answer:
			"If remediation is worth it for your goals, we execute cleanup in clear scope order: architecture simplification, refactors, and test hardening with predictable delivery rhythm."
	}
];

const organizationSchema = {
	"@context": "https://schema.org",
	"@type": "Organization",
	name: brandName,
	url: siteUrl,
	description,
	areaServed: "Worldwide",
	serviceType: "Codebase risk audit and shipping velocity restoration",
	knowsAbout: [
		"Shipping Velocity",
		"Technical Debt",
		"AI-assisted Development",
		"Codebase Stabilization",
		"Software Refactoring"
	]
};

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: faqs.map((item) => ({
		"@type": "Question",
		name: item.question,
		acceptedAnswer: {
			"@type": "Answer",
			text: item.answer
		}
	}))
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="canonical" href={siteUrl} />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={siteUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
		<style>
			:root {
				color-scheme: light;
				--bg: #f7efe2;
				--paper: #fff7eb;
				--text: #191919;
				--muted: #4d4d4d;
				--line: #191919;
				--accent: #f4c7dc;
				--accent-2: #ffd958;
				--surface: #ffffff;
				--shadow: 6px 6px 0 #191919;
				--radius: 18px;
				--tone-a: #fff9ef;
				--tone-b: #fff4fb;
				--signal: #e8f4ff;
			}

			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			html,
			body {
				margin: 0;
				padding: 0;
				background: var(--bg);
				color: var(--text);
				font-family: "Inter", "Avenir Next", "Helvetica Neue", Arial, sans-serif;
				line-height: 1.5;
			}

			a {
				color: inherit;
			}

			.page {
				max-width: 1120px;
				margin: 0 auto;
				padding: 1.2rem 1rem 4rem;
			}

			.nav {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 1rem;
				margin-bottom: 2rem;
				padding: 0.7rem 0.9rem;
				border: 2px solid var(--line);
				background: var(--surface);
				border-radius: 999px;
				box-shadow: 3px 3px 0 var(--line);
			}

			.logo {
				display: inline-flex;
				align-items: center;
				gap: 0.6rem;
				font-weight: 800;
				letter-spacing: -0.02em;
				text-decoration: none;
			}

			.logo-mark {
				width: 28px;
				height: 28px;
				border-radius: 50%;
				border: 2px solid var(--line);
				background: var(--accent-2);
			}

			.nav-cta {
				text-decoration: none;
				border: 2px solid var(--line);
				padding: 0.45rem 0.85rem;
				border-radius: 999px;
				background: var(--text);
				color: #fff;
				font-weight: 700;
				font-size: 0.92rem;
			}

			.hero {
				display: grid;
				gap: 1.2rem;
				padding: 1.5rem;
				border: 2px solid var(--line);
				border-radius: var(--radius);
				background: linear-gradient(130deg, var(--paper) 0%, #fff 56%, var(--accent) 100%);
				box-shadow: var(--shadow);
			}

			.kicker {
				display: inline-block;
				align-self: start;
				padding: 0.25rem 0.65rem;
				background: var(--accent-2);
				border: 2px solid var(--line);
				border-radius: 999px;
				font-weight: 700;
				font-size: 0.82rem;
				letter-spacing: 0.02em;
				text-transform: uppercase;
			}

			h1,
			h2,
			h3 {
				line-height: 1.1;
				letter-spacing: -0.03em;
				margin: 0;
			}

			h1 {
				font-size: clamp(1.95rem, 4.8vw, 3.8rem);
				max-width: 18ch;
			}

			.hero p {
				margin: 0;
				font-size: clamp(1rem, 2.1vw, 1.25rem);
				max-width: 63ch;
				color: var(--muted);
			}

			.hero-signal {
				margin: 0;
				padding: 0.75rem 0.9rem;
				border: 2px solid var(--line);
				border-radius: 12px;
				background: var(--signal);
				font-weight: 600;
				color: var(--text);
				font-size: 0.98rem;
			}

			.hero-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
			}

			.hero-note {
				margin: 0.15rem 0 0;
				font-size: 0.93rem;
				color: var(--muted);
			}

			.btn {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 0.74rem 1rem;
				border-radius: 14px;
				font-weight: 700;
				text-decoration: none;
				border: 2px solid var(--line);
				transition: transform 140ms ease;
			}

			.btn:hover {
				transform: translate(-1px, -1px);
			}

			.btn-primary {
				background: var(--text);
				color: #fff;
			}

			.btn-secondary {
				background: #fff;
			}

			.section {
				margin-top: 2rem;
				display: grid;
				gap: 1rem;
			}

			.section-focus {
				padding: 1.15rem;
				border: 2px solid var(--line);
				border-radius: 16px;
				box-shadow: 5px 5px 0 var(--line);
			}

			.tone-a {
				background: var(--tone-a);
			}

			.tone-b {
				background: var(--tone-b);
			}

			.section-head {
				display: grid;
				gap: 0.45rem;
			}

			.section-title {
				font-size: clamp(1.4rem, 3vw, 2.2rem);
			}

			.section-lead {
				margin: 0;
				max-width: 64ch;
				color: var(--muted);
			}

			.cards {
				display: grid;
				grid-template-columns: repeat(12, 1fr);
				gap: 1rem;
			}

			.card {
				grid-column: span 12;
				padding: 1rem;
				border: 2px solid var(--line);
				border-radius: 15px;
				background: var(--surface);
				box-shadow: 4px 4px 0 var(--line);
			}

			.card p {
				margin: 0.55rem 0 0;
				color: var(--muted);
			}

			.card-flag {
				display: inline-block;
				margin-bottom: 0.35rem;
				font-size: 0.78rem;
				font-weight: 800;
				text-transform: uppercase;
				letter-spacing: 0.04em;
				color: var(--muted);
			}

			.checklist {
				list-style: none;
				padding: 0;
				margin: 0;
				display: grid;
				gap: 0.55rem;
			}

			.checklist label {
				display: flex;
				align-items: flex-start;
				gap: 0.65rem;
				padding: 0.8rem 0.9rem;
				border: 2px solid var(--line);
				border-radius: 12px;
				background: #fff;
				cursor: pointer;
				font-weight: 500;
			}

			.checklist input {
				margin-top: 0.2rem;
				width: 1rem;
				height: 1rem;
				accent-color: var(--text);
				flex-shrink: 0;
			}

			.check-result {
				margin: 0;
				padding: 0.85rem 1rem;
				border: 2px solid var(--line);
				border-radius: 12px;
				background: var(--accent-2);
				font-weight: 600;
				display: none;
			}

			.check-result.visible {
				display: block;
			}

			.audit-card {
				padding: 1.1rem;
				border: 2px solid var(--line);
				border-radius: 15px;
				background: var(--surface);
				box-shadow: 4px 4px 0 var(--line);
			}

			.audit-meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin: 0.6rem 0 0.75rem;
			}

			.audit-tag {
				font-size: 0.82rem;
				font-weight: 700;
				padding: 0.2rem 0.55rem;
				border: 2px solid var(--line);
				border-radius: 999px;
				background: var(--accent-2);
			}

			.audit-list {
				margin: 0.5rem 0 0;
				padding-left: 1.1rem;
				color: var(--muted);
			}

			.answer-grid {
				display: grid;
				grid-template-columns: repeat(12, 1fr);
				gap: 1rem;
			}

			.answer {
				grid-column: span 12;
				padding: 1rem;
				border: 2px solid var(--line);
				border-radius: 12px;
				background: #fff;
			}

			.answer strong {
				display: inline-block;
				margin-bottom: 0.4rem;
			}

			.timeline {
				list-style: none;
				padding: 0;
				margin: 0;
				display: grid;
				gap: 0.8rem;
			}

			.timeline li {
				padding: 0.95rem;
				border: 2px solid var(--line);
				border-radius: 12px;
				background: #fff;
			}

			.timeline span {
				font-weight: 800;
				display: block;
				margin-bottom: 0.2rem;
			}

			.faq {
				display: grid;
				gap: 0.65rem;
			}

			.faq details {
				border: 2px solid var(--line);
				border-radius: 12px;
				background: #fff;
				padding: 0.8rem 0.95rem;
			}

			.faq summary {
				cursor: pointer;
				font-weight: 700;
			}

			.cta {
				margin-top: 2.2rem;
				padding: 1.2rem;
				border: 2px solid var(--line);
				background: var(--accent-2);
				border-radius: var(--radius);
				box-shadow: var(--shadow);
			}

			.cta p {
				margin: 0.6rem 0 0;
				color: #2b2b2b;
			}

			.footer {
				margin-top: 1.8rem;
				font-size: 0.95rem;
				color: var(--muted);
			}

			@media (min-width: 760px) {
				.card.span-6 {
					grid-column: span 6;
				}

				.card.span-4 {
					grid-column: span 4;
				}

				.answer {
					grid-column: span 4;
				}
			}
		</style>
	</head>
	<body>
		<div class="page">
			<header class="nav">
				<a class="logo" href="/">
					<span class="logo-mark" aria-hidden="true"></span>
					<span>{brandName}</span>
				</a>
				<a class="nav-cta" href="/apply">Start Vibe Debt Audit</a>
			</header>

			<main>
				<section class="hero">
					<span class="kicker">10+ years of engineering expertise · diagnose before we fix</span>
					<h1>If your team slowed down after moving fast, we fix that.</h1>
					<p class="hero-signal">
						Key signal: shipping velocity dropped while effort increased — and nobody fully trusts parts of
						the codebase anymore.
					</p>
					<p>
						{brandName} restores speed, confidence, and predictability in unstable codebases. We start with a
						fixed-scope audit, then remediate in clear priority order — no vanity rewrite, no open-ended
						consulting theater.
					</p>
					<div class="hero-actions">
						<a class="btn btn-primary" href="/apply">Start Vibe Debt Audit</a>
						<a class="btn btn-secondary" href="#vibe-debt-check">Check your signals</a>
					</div>
					<p class="hero-note">3–5 day audit · risk map · what breaks next · cleanup priority · then scoped remediation.</p>
				</section>

				<section class="section section-focus tone-a" aria-labelledby="icp-title">
					<div class="section-head">
						<h2 class="section-title" id="icp-title">You might already be our buyer</h2>
						<p class="section-lead">
							Most teams do not self-identify as “vibe coders.” They feel delivery friction, fear touching
							fragile areas, and watch fires multiply.
						</p>
					</div>
					<div class="cards">
						{
							icpSignals.map((item) => (
								<article class="card span-4">
									<span class="card-flag">Common pattern</span>
									<h3>{item.title}</h3>
									<p>{item.pain}</p>
								</article>
							))
						}
					</div>
				</section>

				<section
					class="section section-focus tone-b"
					id="vibe-debt-check"
					aria-labelledby="check-title"
				>
					<div class="section-head">
						<h2 class="section-title" id="check-title">Do you have vibe debt?</h2>
						<p class="section-lead">
							This is a self-diagnosis, not a sales quiz. If two or more sound familiar, an audit is
							usually the right next step.
						</p>
					</div>
					<ul class="checklist" id="vibe-debt-list">
						{
							vibeDebtChecks.map((item, index) => (
								<li>
									<label>
										<input type="checkbox" data-check={index} />
										<span>{item}</span>
									</label>
								</li>
							))
						}
					</ul>
					<p class="check-result" id="check-result" role="status" aria-live="polite"></p>
				</section>

				<section class="section section-focus tone-a" aria-labelledby="problem-title">
					<div class="section-head">
						<h2 class="section-title" id="problem-title">The pain is velocity, not labels</h2>
						<p class="section-lead">
							Fast AI-assisted builds often hide complexity until shipping gets harder, releases feel
							fragile, and every fix creates new risk.
						</p>
					</div>
					<div class="cards">
						<article class="card span-4">
							<h3>Speed back</h3>
							<p>Features that used to take days now take weeks because the system fights every change.</p>
						</article>
						<article class="card span-4">
							<h3>Confidence back</h3>
							<p>Your team avoids touching “cursed” modules, so product decisions get constrained by fear.</p>
						</article>
						<article class="card span-4">
							<h3>Fewer fires</h3>
							<p>Recurring bugs and brittle flows drain focus from growth work you actually care about.</p>
						</article>
					</div>
				</section>

				<section class="section section-focus tone-b" aria-labelledby="audit-title">
					<div class="section-head">
						<h2 class="section-title" id="audit-title">Start with a Vibe Debt Audit</h2>
						<p class="section-lead">
							Lower friction than a full cleanup engagement. Prove the problem, quantify risk, and decide
							if remediation is worth it for your goals.
						</p>
					</div>
					<article class="audit-card">
						<h3>Fixed scope. Clear deliverables. Natural upsell path.</h3>
						<div class="audit-meta">
							<span class="audit-tag">3–5 days</span>
							<span class="audit-tag">€1k–€3k</span>
							<span class="audit-tag">No rewrite by default</span>
						</div>
						<p>You get a practical read on how bad things are, what is actually risky, and what to fix first.</p>
						<ul class="audit-list">
							<li>Codebase risk map with severity and blast radius</li>
							<li>“What will likely break in 3 months” forecast</li>
							<li>Prioritized cleanup sequence tied to business impact</li>
							<li>Go / no-go recommendation for full remediation</li>
						</ul>
						<p style="margin-top: 1rem;">
							<a class="btn btn-primary" href="/apply">Apply for Vibe Debt Audit</a>
						</p>
					</article>
				</section>

				<section class="section section-focus tone-a" aria-labelledby="services-title">
					<div class="section-head">
						<h2 class="section-title" id="services-title">After the audit: scoped cleanup</h2>
						<p class="section-lead">
							Same rhythm every engagement — assess first, then execute in priority order without
							guesswork.
						</p>
					</div>
					<div class="cards">
						<article class="card span-6">
							<h3>1) Deep assessment</h3>
							<p>
								We quantify debt, ownership gaps, and timeline to stabilize — and whether remediation
								matches your business goals.
							</p>
						</article>
						<article class="card span-6">
							<h3>2) Guided remediation</h3>
							<p>
								We refactor fragile areas, harden quality, and restore a codebase your team can ship from
								again with confidence.
							</p>
						</article>
					</div>
				</section>

				<section class="section section-focus tone-b" aria-labelledby="answers-title">
					<div class="section-head">
						<h2 class="section-title" id="answers-title">Quick answers for search and decision-makers</h2>
						<p class="section-lead">Direct answers people and retrieval systems can parse fast.</p>
					</div>
					<div class="answer-grid">
						<article class="answer">
							<strong>What do you sell?</strong>
							<div>
								Shipping velocity back — through audit-first diagnosis and scoped stabilization, not
								generic “cleanup.”
							</div>
						</article>
						<article class="answer">
							<strong>When should we act?</strong>
							<div>
								When velocity drops while effort rises. Waiting usually compounds fragile architecture
								and firefighting cost.
							</div>
						</article>
						<article class="answer">
							<strong>Who should reach out?</strong>
							<div>
								Founders post-MVP, traction-stage solo builders, and agencies maintaining fast AI-shipped
								client codebases.
							</div>
						</article>
					</div>
				</section>

				<section class="section section-focus tone-a" aria-labelledby="process-title">
					<div class="section-head">
						<h2 class="section-title" id="process-title">How engagements run</h2>
						<p class="section-lead">Predictable delivery rhythm from first call to stable shipping again.</p>
					</div>
					<ol class="timeline">
						<li>
							<span>Step 1 — Align on pain</span>
							We map where velocity dropped, what is fragile, and what outcomes matter for the business.
						</li>
						<li>
							<span>Step 2 — Audit and risk map</span>
							We inspect architecture, ownership, and where fast builds created hidden complexity.
						</li>
						<li>
							<span>Step 3 — Prioritized roadmap</span>
							We sequence fixes by risk and impact so remediation stays scoped and executable.
						</li>
						<li>
							<span>Step 4 — Stabilize and hand back velocity</span>
							We refactor fragile areas, harden quality, and leave a maintainable system your team can own.
						</li>
					</ol>
				</section>

				<section class="section section-focus tone-b" id="faq" aria-labelledby="faq-title">
					<div class="section-head">
						<h2 class="section-title" id="faq-title">FAQ</h2>
						<p class="section-lead">Fast answers before we start.</p>
					</div>
					<div class="faq">
						{
							faqs.map((item) => (
								<details>
									<summary>{item.question}</summary>
									<p>{item.answer}</p>
								</details>
							))
						}
					</div>
				</section>

				<section class="section section-focus tone-a" aria-labelledby="boundaries-title">
					<div class="section-head">
						<h2 class="section-title" id="boundaries-title">What we don’t do</h2>
						<p class="section-lead">Clear boundaries keep audits fast and remediation execution-focused.</p>
					</div>
					<div class="cards">
						<article class="card span-4">
							<h3>No business-operation role</h3>
							<p>We don’t run your business or provide business advice.</p>
						</article>
						<article class="card span-4">
							<h3>No ongoing maintenance retainer</h3>
							<p>We don’t do ongoing maintenance after the scoped engagement.</p>
						</article>
						<article class="card span-4">
							<h3>No net-new feature builds</h3>
							<p>We don’t build new features inside stabilization work.</p>
						</article>
					</div>
				</section>

				<section class="cta" aria-labelledby="cta-title">
					<h2 id="cta-title">Get shipping velocity back without starting from zero.</h2>
					<p>
						If delivery is slowing down while your team works harder, start with a Vibe Debt Audit. We’ll
						show you what is risky, what breaks next, and what to fix first.
					</p>
					<p>
						<a class="btn btn-primary" href="/apply">Apply for Vibe Debt Audit</a>
						<a
							class="btn btn-secondary"
							style="margin-left: 0.5rem;"
							href="mailto:hello@thevibecrew.dev?subject=Vibe%20Debt%20Audit%20Question"
							>Ask a quick question</a
						>
					</p>
				</section>
			</main>

			<footer class="footer">
				<p>
					{brandName} · Restore shipping velocity in unstable codebases · Audit-first remediation for fast-built
					software · Serving teams worldwide.
				</p>
			</footer>
		</div>

		<script>
			const boxes = document.querySelectorAll<HTMLInputElement>("#vibe-debt-list input[type='checkbox']");
			const result = document.getElementById("check-result");

			function updateCheck() {
				if (!result) return;
				const count = [...boxes].filter((b) => b.checked).length;
				if (count >= 2) {
					result.textContent =
						`${count} signals checked — you likely have compounding vibe debt. A Vibe Debt Audit is the right next step.`;
					result.classList.add("visible");
				} else if (count === 1) {
					result.textContent =
						"One signal so far. If more show up in the next few weeks, run the audit before velocity drops further.";
					result.classList.add("visible");
				} else {
					result.textContent = "";
					result.classList.remove("visible");
				}
			}

			boxes.forEach((box) => box.addEventListener("change", updateCheck));
		</script>
	</body>
</html>
